# Development-only Mac TTS server. Leave unset to show only the device TTS.
# iOS simulator: http://127.0.0.1:8765
# Physical device: http://<mac-lan-ip>:8765
EXPO_PUBLIC_LOCAL_TTS_URL=

# Optional temporary LAN token. This is embedded in the development app and is
# not a production secret mechanism.
EXPO_PUBLIC_LOCAL_TTS_TOKEN=
