{
  "expo": {
    "name": "Listen AI",
    "slug": "listen-ai",
    "scheme": "listenai",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#E4FFD6"
    },
    "ios": {
      "bundleIdentifier": "com.slhttnunlu.listenai",
      "buildNumber": "1",
      "supportsTablet": true
    },
    "android": {
      "package": "com.slhttnunlu.listenai",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E4FFD6"
      }
    },
    "plugins": [
      "expo-asset",
      "expo-document-picker",
      "expo-status-bar",
      "expo-sqlite",
      "expo-sharing"
    ]
  }
}
