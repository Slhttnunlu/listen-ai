{
  "expo": {
    "name": "Listen AI",
    "slug": "listen-ai",
    "scheme": "listenai",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#E4FFD6"
    },
    "ios": {
      "bundleIdentifier": "com.slhttnunlu.listenai",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Geliştirme sırasında Mac üzerindeki yerel ses servisine bağlanmak için yerel ağ erişimi kullanılır.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.slhttnunlu.listenai",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E4FFD6"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Metin taramak için kameranıza erişim izni gerekiyor.",
          "microphonePermission": false,
          "photosPermission": "Metin taramak için seçtiğiniz fotoğrafa erişim izni gerekiyor."
        }
      ],
      "expo-document-picker",
      "expo-status-bar",
      "expo-sqlite",
      "expo-sharing",
      "./plugins/withIosSceneLifecycle",
      "expo-audio"
    ]
  }
}
