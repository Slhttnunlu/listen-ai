{
  "expo": {
    "name": "Listen AI",
    "slug": "listen-ai",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#E4FFD6"
    },
    "ios": {
      "bundleIdentifier": "com.slhttnunlu.listenai",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E4FFD6"
      }
    },
    "plugins": ["expo-asset", "expo-document-picker", "expo-status-bar", "expo-sqlite"]
  }
}
